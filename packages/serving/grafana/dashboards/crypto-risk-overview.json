    {
      "id": 1,
      "title": "Volatilidad (stddev_price)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "rawSql": "SELECT window_start AS time, symbol, stddev_price FROM gold_volatility WHERE symbol IN (${symbol:sqlstring}) ORDER BY window_start",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Spread medio (avg_spread)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "rawSql": "SELECT window_start AS time, symbol, avg_spread FROM gold_spread WHERE symbol IN (${symbol:sqlstring}) ORDER BY window_start",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Liquidez media por nivel (avg_depth_quantity)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "rawSql": "SELECT window_start AS time, CONCAT(symbol, ' - ', side) AS metric, avg_depth_quantity FROM gold_liquidity WHERE symbol IN (${symbol:sqlstring}) ORDER BY window_start",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          }
        },
