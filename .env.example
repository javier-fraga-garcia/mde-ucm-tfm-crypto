WS_BASE_URL=wss://stream.binance.com:9443/stream
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
KAFKA_BOOTSTRAP_SERVERS=kafka:29092 # configuración para el servicio de docker compose. En local usar localhost:9092
KAFKA_TOPIC=kafka-envelope
LOG_LEVEL=INFO

BRONZE_TABLE_PATH=s3a://lakehouse/bronze/kafka_envelope
BRONZE_CHECKPOINT_PATH=s3a://lakehouse/checkpoints/bronze
BRONZE_TRIGGER_INTERVAL=30 seconds

SILVER_TABLE_PATH=s3a://lakehouse/silver/placeholder
SILVER_CHECKPOINT_PATH=s3a://lakehouse/checkpoints/silver
SILVER_TRIGGER_INTERVAL=30 seconds

GOLD_TABLE_PATH=s3a://lakehouse/gold/placeholder
GOLD_CHECKPOINT_PATH=s3a://lakehouse/checkpoints/gold
GOLD_TRIGGER_INTERVAL=1 minute

S3_ENDPOINT_URL=http://localhost:4566 # floci:4566 
S3_ACCESS_KEY=test
S3_SECRET_KEY=test